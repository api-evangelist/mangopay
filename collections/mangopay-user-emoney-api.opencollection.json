{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mangopay REST Bank Accounts User EMoney API",
    "version": "2.01"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.mangopay.com/v2.01/{clientId}/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "User EMoney",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "View User EMoney",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mangopay.com/v2.01/{clientId}/users/:userId/emoney",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "[https://mangopay.com/docs/endpoints/user-emoney#view-user-emoney](https://mangopay.com/docs/endpoints/user-emoney#view-user-emoney)"
        }
      ]
    }
  ],
  "bundled": true
}