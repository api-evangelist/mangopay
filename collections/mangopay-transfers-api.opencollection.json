{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mangopay REST Bank Accounts Transfers API",
    "version": "2.01"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.mangopay.com/v2.01/{clientId}/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Transfers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a Transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mangopay.com/v2.01/{clientId}/transfers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "[https://mangopay.com/docs/endpoints/transfers#create-transfer](https://mangopay.com/docs/endpoints/transfers#create-transfer)"
        },
        {
          "info": {
            "name": "View a Transfer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mangopay.com/v2.01/{clientId}/transfers/:transferId",
            "params": [
              {
                "name": "transferId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "[https://mangopay.com/docs/endpoints/transfers#view-transfer](https://mangopay.com/docs/endpoints/transfers#view-transfer)"
        }
      ]
    }
  ],
  "bundled": true
}